# Core settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-goes-here-make-it-secure

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.105

# Database config
# SQLite for local: sqlite:///db.sqlite3
# PostgreSQL: postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Celery and Redis config
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Allowed Frontend Origins (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.105:3000

# Meta Webhook Verify Token (Must match token set in Meta Dev Portal)
META_VERIFY_TOKEN=darkfalcon_verify_token_123
