                    </tr>
                  </thead>
                  <tbody>
                    {adminSessions.map(s => (
                      <tr key={s.id}>
                        <td>#{s.id}</td>
                        <td>{s.instance_name}</td>
                        <td>{s.phone_number || '-'}</td>
                        <td>{s.user || 'Unknown'}</td>
                        <td>{s.instance_type}</td>
                        <td>{s.status}</td>
                        <td>
                          <button onClick={() => handleTerminateSession(s.id)} className="btn btn-xs btn-error">
                            {locale === 'ar' ? 'إنهاء الاتصال' : 'Terminate Connection'}
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
