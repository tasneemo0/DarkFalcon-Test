                  </span>

                  <strong>{locale === 'ar' ? 'الحالة:' : 'Status:'}</strong>
                  <span>{user?.is_active ? (locale === 'ar' ? 'نشط' : 'Active') : (locale === 'ar' ? 'معطل' : 'Suspended')}</span>
                </div>
              </div>

              { }
              <div style={{ background: 'var(--surface)', border: '1px solid var(--border-light)', padding: '24px', borderRadius: 'var(--radius-xl)', display: 'flex', flexDirection: 'column', gap: '16px' }}>
                <h3 style={{ fontWeight: 700 }}>{locale === 'ar' ? 'تواصل معنا (الدعم الفني)' : 'Contact Us / Platform Support'}</h3>
                <p style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>
                  {locale === 'ar' ?
