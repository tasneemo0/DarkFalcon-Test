                  <div className={styles.statCardLabel}>{locale === 'ar' ? 'إجمالي العملاء' : 'Total Registered Clients'}</div>
                </div>
                <div className={styles.statCard}>
                  <div className={styles.statCardValue}>{adminStats?.active_sessions || 0}</div>
                  <div className={styles.statCardLabel}>{locale === 'ar' ? 'الجلسات النشطة بالواتساب' : 'Active WhatsApp Sessions'}</div>
                </div>
                <div className={styles.statCard}>
                  <div className={styles.statCardValue}>{adminStats?.sent_messages_today || 0}</div>
