              <h3 style={{ marginBottom: '16px', fontWeight: 700 }}>{locale === 'ar' ? 'سجل مدفوعات العملاء والفواتير الصادرة' : 'System Payment Invoices Audit'}</h3>

              <div className={styles.tableWrapper}>
